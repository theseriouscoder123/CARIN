{
  "name": "cairn",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --continue=always --filter=@cairn/indexer --filter=@cairn/web",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "chain": "pnpm --filter @cairn/contracts node",
    "deploy:local": "pnpm --filter @cairn/contracts deploy:local",
    "seed:local": "pnpm --filter @cairn/contracts seed:local",
    "cairn": "node packages/cli/dist/index.js",
    "attesters:up": "pnpm --filter @cairn/attester build && node apps/attester/scripts/up.mjs",
    "registry:up": "verdaccio --config fixtures/demo/verdaccio.yaml",
    "registry:reset": "node fixtures/demo/scripts/registry-reset.mjs",
    "attesters:demo": "pnpm --filter @cairn/attester build && node apps/attester/scripts/up.mjs --registry http://127.0.0.1:4873",
    "demo:release": "node fixtures/demo/scripts/release.mjs",
    "demo:tamper": "node fixtures/demo/scripts/tamper.mjs",
    "demo:recheck": "node fixtures/demo/scripts/recheck.mjs",
    "demo:verify": "node packages/cli/dist/index.js verify --lockfile fixtures/demo/consumer/package-lock.json",
    "test:integration": "node test/integration/demo-path.mjs",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "@cairn/cli": "workspace:*",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "verdaccio": "6.11.2"
  }
}
