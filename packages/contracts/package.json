{
  "name": "@cairn/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "hardhat": "hardhat",
    "build": "hardhat compile && node scripts/export-abi.mjs",
    "test": "hardhat test",
    "typecheck": "hardhat compile --quiet && tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern test scripts",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "seed:local": "hardhat run scripts/seed.ts --network localhost",
    "deploy:base-sepolia": "hardhat run scripts/deploy.ts --network baseSepolia",
    "fund:base-sepolia": "hardhat run scripts/fund.ts --network baseSepolia",
    "seed": "hardhat run scripts/seed.ts"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@cairn/cli": "workspace:*",
    "@cairn/config": "workspace:*",
    "@cairn/core": "workspace:*",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.2",
    "@nomicfoundation/hardhat-viem": "3.1.0",
    "@nomicfoundation/hardhat-viem-assertions": "3.1.5",
    "hardhat": "3.22.0",
    "viem": "2.57.20"
  }
}
